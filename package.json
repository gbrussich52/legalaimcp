{
  "name": "legalaimcp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "curate:discover": "node scripts/curate.mjs discover",
    "curate:links": "node scripts/curate.mjs check-links",
    "postbuild": "node scripts/check-catalog-artifacts.mjs",
    "chatgpt:build": "node scripts/build-chatgpt-widget.mjs",
    "prebuild": "npm run chatgpt:build",
    "predev": "npm run chatgpt:build",
    "chatgpt:package": "python3 scripts/package-chatgpt.py",
    "catalog:import": "node scripts/import-reviewed-catalog.mjs",
    "catalog:verify": "node --env-file=.env.local scripts/import-reviewed-catalog.mjs --audit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/supabase-js": "^2.102.1",
    "@tailwindcss/typography": "0.5.20",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.7.0",
    "mcp-handler": "1.1.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    },
    "mcp-handler": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  }
}
