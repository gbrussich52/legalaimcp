# Public Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only Supabase (admin + Stripe webhook)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional site URL override for Checkout success/cancel redirects
NEXT_PUBLIC_SITE_URL=https://legalaimcp.com

# Stripe Featured placements ($79 / 30-day bump)
# Use test keys locally (sk_test_… / pk_test_…). Never commit real secrets.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Create a one-time Price of $79.00 USD in Stripe Dashboard, paste price_… id:
STRIPE_PRICE_FEATURED_30D=price_placeholder

# Cron: GET/POST /api/cron/expire-featured with Authorization: Bearer <secret>
CRON_SECRET=generate_a_long_random_string
